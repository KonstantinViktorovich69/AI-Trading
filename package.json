{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "tsx scripts/verify-integration.ts",
    "test:e2e:offline": "tsx scripts/test-e2e-offline.ts",
    "test:production-path:offline": "tsx scripts/test-production-path-offline.ts",
    "test:production-path-offline": "tsx scripts/test-production-path-offline.ts",
    "test:runtime": "tsx scripts/verify-runtime-bundle.ts",
    "verify:install": "tsx scripts/verify-install.ts",
    "verify:wiring": "tsx scripts/verify-integration-wiring.ts",
    "verify:integration-wiring": "tsx scripts/verify-integration-wiring.ts",
    "verify:secrets": "tsx scripts/verify-secrets.ts",
    "seed:demo": "tsx scripts/seed-demo-data.ts",
    "migrate:trades": "tsx scripts/migrate-trade-audit-fields.ts",
    "package:release": "node scripts/create-release-candidate.mjs",
    "verify:release-package": "node scripts/verify-release-candidate.mjs",
    "test:release-negative": "node scripts/test-release-candidate-negative-fixtures.mjs"
  },
  "dependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.1",
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.24.1",
    "@sentry/node": "^10.51.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "ccxt": "^4.5.54",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.12.0",
    "firebase-admin": "^13.8.0",
    "ioredis": "^5.10.1",
    "lightweight-charts": "^5.1.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.5.0",
    "technicalindicators": "^3.1.0",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.4",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.9"
  }
}
