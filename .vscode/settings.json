{
  "json.schemas": [
    {
      "fileMatch": [
        "/settings.json",
        "settings.json",
        "**/settings.json",
        "**/known-good-settings-copy",
        "known-good-settings-copy"
      ],
      "schema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "fileMatch": [
        "/database.json",
        "database.json",
        "**/database.json",
        "**/known-good-database-copy",
        "known-good-database-copy"
      ],
      "schema": {
        "type": "object",
        "additionalProperties": true
      }
    }
  ],
  "json.maxItemsComputed": 500000
}
